# Go runtime / Turso. Production is stateless; there is no local SQLite file or Fly volume.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BASE_URL=https://plantingtulips.com
ADDR=:8080

# Optional XVideos partner/feed integration. Do not point this at a scraper.
XVIDEOS_PARTNER_JSON_ENDPOINT=
# Optional exact Authorization header required by the approved partner normalization endpoint.
XVIDEOS_PARTNER_AUTHORIZATION=

# Optional moderation/takedown relay. Reports are always stored in Turso first.
REPORT_WEBHOOK_URL=

# Required for scheduled catalog ingestion.
INGEST_SECRET=

# Required for /api/v1/admin/* operator endpoints. Falls back to INGEST_SECRET if omitted.
ADMIN_TOKEN=

# Frontend monetization: off | preview | exoclick.
VITE_AD_MODE=off
# Use the exact HTTPS async script URL generated by the ExoClick publisher dashboard.
VITE_EXOCLICK_SCRIPT_URL=
VITE_EXOCLICK_ZONE_FEED_BANNER=
VITE_EXOCLICK_ZONE_SIDEBAR=
VITE_EXOCLICK_ZONE_PLAYER_BELOW=
VITE_EXOCLICK_ZONE_NATIVE_CARD=
